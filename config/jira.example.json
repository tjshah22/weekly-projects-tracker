{
  "base_url": "https://your-domain.atlassian.net",
  "email_env": "JIRA_EMAIL",
  "api_token_env": "JIRA_API_TOKEN",
  "fields": [
    "summary",
    "status",
    "assignee",
    "priority",
    "labels",
    "components",
    "fixVersions",
    "duedate",
    "updated",
    "issuetype",
    "customfield_10020",
    "customfield_10014",
    "customfield_10011",
    "customfield_10016"
  ],
  "queries": [
    {
      "name": "F2 and F3 active work",
      "jql": "project in (F2, F3) AND statusCategory != Done ORDER BY priority DESC, updated DESC",
      "max_results": 100
    },
    {
      "name": "F2 and F3 recently completed",
      "jql": "project in (F2, F3) AND statusCategory = Done AND resolved >= -14d ORDER BY resolved DESC",
      "max_results": 100
    }
  ],
  "boards": [
    {
      "name": "F2 Jira Board",
      "board_id": 12345,
      "jql": "updated >= -14d OR statusCategory != Done",
      "max_results": 100
    },
    {
      "name": "F3 Jira Board",
      "board_id": 67890,
      "jql": "updated >= -14d OR statusCategory != Done",
      "max_results": 100
    }
  ]
}
